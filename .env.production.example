# Copy to .env on the server. Replace every placeholder. Never commit .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=203.0.113.10
DJANGO_CSRF_TRUSTED_ORIGINS=https://203.0.113.10
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_LOG_LEVEL=INFO
DJANGO_PASSWORD_RESET_ENABLED=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=glidecrm@localhost

MYSQL_DATABASE=glidecrm
MYSQL_USER=glidecrm
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MYSQL_CONN_MAX_AGE=60

# Public IP, or the hostname after you own a domain. No scheme, no port.
SITE_ADDRESS=203.0.113.10

# Leave empty until you choose backup storage. Then set a rclone remote path.
BACKUP_RCLONE_DEST=

# Local development values only. Replace every secret for a deployed environment.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-replace-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_TRUST_PROXY_HEADERS=false
# Release profile, after HTTPS works on the final host. Leave these off locally.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<50+ random characters>
# DJANGO_ALLOWED_HOSTS=crm.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
# DJANGO_SECURE_COOKIES=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_LOG_LEVEL=INFO
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=glidecrm@localhost
# Password reset email stays off until Graph shared-mailbox mail (Phase 10C).
DJANGO_PASSWORD_RESET_ENABLED=false
# TOTP MFA for every active user (Phase 10B). Set false only for special recovery.
DJANGO_MFA_REQUIRED=true

# Phase 10C — Microsoft Graph shared mailbox (leave blank until Entra app is ready).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# GRAPH_SHARED_MAILBOX=crm@yourdomain.com
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# After Graph send works, set DJANGO_PASSWORD_RESET_ENABLED=true for invite/reset mail.

MYSQL_DATABASE=glidecrm
MYSQL_USER=glidecrm
MYSQL_PASSWORD=development-only-database-password
MYSQL_ROOT_PASSWORD=development-only-root-password
MYSQL_EXPOSE_PORT=3306
MYSQL_CONN_MAX_AGE=60

WEB_PORT=8000
